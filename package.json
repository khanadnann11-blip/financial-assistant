{
  "name": "folio-financial-assistant",
  "version": "1.0.0",
  "description": "A grounded personal finance assistant with persistent accounts, budgets and goals.",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_PATH=:memory: tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanadnann11-blip/financial-assistant.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/khanadnann11-blip/financial-assistant/issues"
  },
  "homepage": "https://github.com/khanadnann11-blip/financial-assistant#readme",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
